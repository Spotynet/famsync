# Mock mode: no backend. Use fake users (see lib/mockAuth.ts).
# demo@famsync.app / 123456 | test@famsync.app / 654321 | ana@famsync.app / 111111
EXPO_PUBLIC_USE_MOCK_AUTH=true

# Backend API URL
# - Local: http://localhost:3006 (or your dev port)
# - EAS / devices: https://famsync-api-dev.spotynet.com
EXPO_PUBLIC_API_URL=http://localhost:3006

# Google OAuth — Web Client ID (same as backend GOOGLE_CLIENT_ID)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Hosted Expo web dev (expo-router deep link path is /--/auth)
# Add to Google Cloud → Web client:
#   Authorized JavaScript origins: https://famsync-dev.spotynet.com
#   Authorized redirect URIs:       https://famsync-dev.spotynet.com/--/auth
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=https://famsync-dev.spotynet.com/--/auth
