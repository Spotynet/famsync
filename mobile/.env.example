# Mock mode: no backend. Use fake users (see lib/mockAuth.ts).
# demo@famsync.app / 123456 | test@famsync.app / 654321 | ana@famsync.app / 111111
EXPO_PUBLIC_USE_MOCK_AUTH=true

# Backend API URL (ignored when USE_MOCK_AUTH=true)
# - iOS Simulator: http://localhost:8001
# - Android Emulator: http://10.0.2.2:8001
# - Physical device: http://YOUR_DEVICE_IP:8001
EXPO_PUBLIC_API_URL=http://localhost:8001

# Google OAuth - Web Client ID from Google Cloud Console
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
