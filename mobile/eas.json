{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_USE_MOCK_AUTH": "false",
        "EXPO_PUBLIC_API_URL": "https://famsync-api-dev.spotynet.com",
        "EXPO_PUBLIC_GOOGLE_REDIRECT_URI": "https://famsync-dev.spotynet.com/--/auth"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_USE_MOCK_AUTH": "false",
        "EXPO_PUBLIC_API_URL": "https://famsync-api-dev.spotynet.com",
        "EXPO_PUBLIC_GOOGLE_REDIRECT_URI": "https://famsync-dev.spotynet.com/--/auth"
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_USE_MOCK_AUTH": "false",
        "EXPO_PUBLIC_API_URL": "https://famsync-api-dev.spotynet.com",
        "EXPO_PUBLIC_GOOGLE_REDIRECT_URI": "https://famsync-dev.spotynet.com/--/auth"
      }
    }
  }
}
